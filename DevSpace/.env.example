# Copie este arquivo para .env e preencha com os dados reais.
# Nunca commite o arquivo .env.
# Um único .env na raiz do DevSpace: frontend + backend + MySQL.

# --- Frontend (Vite) ---
# Login Google (opcional). Sem isso, o botão Google fica desabilitado.
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
# Opcional. Em dev o Vite já faz proxy de /api para o backend.
# VITE_API_URL=/api

# --- Backend / MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=devspace
DB_USER=devspace
DB_PASSWORD=altere-me

# Porta do Express
PORT=4000

# Origens do frontend permitidas no CORS (separadas por vírgula)
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
